# Database
POSTGRES_USER=prompt-user
POSTGRES_PASSWORD=super-secret-password
POSTGRES_DB=prompt-completion
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db/${POSTGRES_DB}

# Flask
SECRET_KEY=your-secret-key-here

# OpenRouter API (for LLM chat completions)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Embedding Configuration (uses OpenRouter API key)
# Model: google/gemini-embedding-001 via OpenRouter
# Dimensions: 768 (Matryoshka truncation for pgvector compatibility)
EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# WA Sender API Configuration
WA_SENDER_API_URL=https://wasenderapi.com
WA_SENDER_API_KEY=your-wa-sender-api-key
WA_SENDER_WEBHOOK_SECRET=your-webhook-secret